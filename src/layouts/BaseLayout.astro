<script>
(function(){
  var wrap = document.querySelector('.reveal-wrap');
  var stage = document.querySelector('.reveal-stage');
  if(!wrap || !stage) return;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce){ wrap.style.setProperty('--progress','1'); return; }
  var ticking = false;
  function update(){
    var rect = wrap.getBoundingClientRect();
    var total = wrap.offsetHeight - stage.offsetHeight;
    var p = total > 0 ? (-rect.top) / total : 1;
    p = Math.min(1, Math.max(0, p));
    wrap.style.setProperty('--progress', p.toFixed(4));
    ticking = false;
  }
  function onScroll(){
    if(!ticking){ requestAnimationFrame(update); ticking = true; }
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  window.addEventListener('resize', onScroll);
  update();
})();
</script>

<script>
(function(){
  var burger = document.getElementById('menu-toggle');
  var menu = document.getElementById('mobile-menu');
  if(!burger || !menu) return;
  function close(){
    menu.classList.remove('open');
    burger.classList.remove('open');
    burger.setAttribute('aria-expanded','false');
  }
  burger.addEventListener('click', function(){
    var open = menu.classList.toggle('open');
    burger.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  menu.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click', close);
  });
  window.addEventListener('resize', function(){
    if(window.innerWidth >= 900) close();
  });
})();
</script>

<script>
(function(){
  var strip = document.querySelector('.rev-strip');
  var prev = document.getElementById('rev-prev');
  var next = document.getElementById('rev-next');
  if(!strip) return;

  function cardStep(){
    var card = strip.querySelector('.rev-card');
    if(!card) return 0;
    var gap = parseFloat(getComputedStyle(strip).columnGap || getComputedStyle(strip).gap || '0') || 0;
    return card.getBoundingClientRect().width + gap;
  }
  function go(dir){
    strip.scrollBy({left: cardStep() * dir, behavior: 'smooth'});
  }
  if(prev) prev.addEventListener('click', function(){ go(-1); });
  if(next) next.addEventListener('click', function(){ go(1); });

  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(!reduce && 'IntersectionObserver' in window){
    var fired = false;
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting && !fired){
          fired = true;
          strip.classList.add('peek-hint');
          io.disconnect();
        }
      });
    }, {threshold: 0.4});
    io.observe(strip);
  }
})();
</script>

<script>
(function(){
  var form = document.querySelector('.cform');
  if(!form) return;
  var submitBtn = form.querySelector('.cform-submit');
  var errorEl = null;

  function showError(msg){
    if(!errorEl){
      errorEl = document.createElement('p');
      errorEl.className = 'cform-error';
      form.appendChild(errorEl);
    }
    errorEl.textContent = msg;
  }

  form.addEventListener('submit', function(e){
    e.preventDefault();
    var name = (form.first_name.value || '').trim();
    var payload = {
      company: form.company ? form.company.value : '',
      first_name: form.first_name.value,
      last_name: form.last_name.value,
      email: form.email.value,
      phone: form.phone.value,
      zip: form.zip.value,
      service: form.service.value,
      message: form.message.value
    };

    if(submitBtn){ submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }
    if(errorEl){ errorEl.remove(); errorEl = null; }

    fetch('/api/contact', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(payload)
    }).then(function(res){
      return res.json().then(function(data){ return {ok: res.ok && data.ok, error: data.error}; });
    }).then(function(result){
      if(!result.ok){
        showError(result.error || 'Something went wrong. Please call us directly at (623) 343-1123.');
        if(submitBtn){ submitBtn.disabled = false; submitBtn.textContent = 'Send Details'; }
        return;
      }
      var success = document.createElement('div');
      success.className = 'cform-success';
      success.innerHTML = '<h3>Thanks' + (name ? ', ' + name : '') + ' &mdash; we\'ll be in touch.</h3>' +
        '<p>We typically respond within one business day. For anything urgent, call (623) 343-1123.</p>';
      form.replaceWith(success);
      success.setAttribute('tabindex', '-1');
      success.focus();
    }).catch(function(){
      showError('Something went wrong. Please call us directly at (623) 343-1123.');
      if(submitBtn){ submitBtn.disabled = false; submitBtn.textContent = 'Send Details'; }
    });
  });
})();
</script>

