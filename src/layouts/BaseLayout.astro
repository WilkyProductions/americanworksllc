  .btn-quote,
  .btn,
  .block-hd p,
  .svc-card p,
  .svc-card.stub .ph span,
  .proof-item p,
  .ba-shell .icon,
  .ba-shell p,
  .stars,
  .rev-card p.q,
  .rev-card .who,
  .rev-card .who span,
  .area-list a,
  .area-note h4,
  .area-note p,
  .p-step .num,
  .p-step p,
  details p,
  .cta-in p,
  .foot-col h5,
  .foot-col a,
  .foot-col p,
  .foot-bottom,
  .mbar a{font-size:var(--mobile-min-text)}
}
