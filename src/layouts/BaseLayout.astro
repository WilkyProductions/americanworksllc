<script>
(function(){
  var video = document.getElementById('hero-video');
  var toggle = document.getElementById('video-toggle');
  if(!video || !toggle) return;
  var pauseIcon = toggle.querySelector('.i-pause');
  var playIcon = toggle.querySelector('.i-play');
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function setState(playing){
    toggle.setAttribute('aria-pressed', playing ? 'false' : 'true');
    toggle.setAttribute('aria-label', playing ? 'Pause background video' : 'Play background video');
    pauseIcon.hidden = !playing;
    playIcon.hidden = playing;
  }
  if(reduce){
    video.pause();
    setState(false);
  }
  toggle.addEventListener('click', function(){
    if(video.paused){ video.play(); setState(true); }
    else { video.pause(); setState(false); }
  });
})();
</script>

<script>
(function(){
  var KEY = 'aw_cookie_consent';
  var banner = document.getElementById('cookie-banner');
  if(!banner) return;
  var stored = null;
  try { stored = localStorage.getItem(KEY); } catch(e) {}
  if(stored){ banner.remove(); return; }
  function dismiss(value){
    try { localStorage.setItem(KEY, value); } catch(e) {}
    banner.remove();
  }
  var acceptBtn = document.getElementById('cookie-accept');
  var declineBtn = document.getElementById('cookie-decline');
  if(acceptBtn) acceptBtn.addEventListener('click', function(){ dismiss('accepted'); });
  if(declineBtn) declineBtn.addEventListener('click', function(){ dismiss('declined'); });
})();
</script>

<script>
(function(){
  var triggers = Array.prototype.slice.call(document.querySelectorAll('.lightbox-trigger'));
  if(!triggers.length) return;

  var items = triggers.map(function(btn){
    var img = btn.querySelector('img');
    return { src: img.src, alt: img.alt, caption: img.alt };
  });

  var lightbox = document.getElementById('lightbox');
  var stageImg = document.getElementById('lightbox-img');
  var caption = document.getElementById('lightbox-caption');
  var closeBtn = document.getElementById('lightbox-close');
  var prevBtn = document.getElementById('lightbox-prev');
  var nextBtn = document.getElementById('lightbox-next');
  var focusable = [closeBtn, prevBtn, nextBtn];
  var current = 0;
  var lastFocused = null;

  function render(){
    var item = items[current];
    stageImg.src = item.src;
    stageImg.alt = item.alt;
    caption.textContent = item.caption;
  }
  function open(index){
    current = index;
    lastFocused = document.activeElement;
    render();
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
    document.addEventListener('keydown', onKeydown);
  }
  function close(){
    lightbox.hidden = true;
    document.body.style.overflow = '';
    document.removeEventListener('keydown', onKeydown);
    if(lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
  }
  function next(){ current = (current + 1) % items.length; render(); }
  function prev(){ current = (current - 1 + items.length) % items.length; render(); }
  function onKeydown(e){
    if(e.key === 'Escape'){ close(); return; }
    if(e.key === 'ArrowRight'){ next(); return; }
    if(e.key === 'ArrowLeft'){ prev(); return; }
    if(e.key === 'Tab'){
      var idx = focusable.indexOf(document.activeElement);
      e.preventDefault();
      var dir = e.shiftKey ? -1 : 1;
      var nextIdx = (idx + dir + focusable.length) % focusable.length;
      focusable[nextIdx].focus();
    }
  }

  triggers.forEach(function(btn, i){
    btn.addEventListener('click', function(){ open(i); });
  });
  closeBtn.addEventListener('click', close);
  prevBtn.addEventListener('click', prev);
  nextBtn.addEventListener('click', next);
  lightbox.addEventListener('click', function(e){
    if(e.target === lightbox) close();
  });
})();
</script>
