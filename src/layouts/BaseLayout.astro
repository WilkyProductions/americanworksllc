.rev-card .who span{font-weight:600;color:var(--accent-ink);font-size:.74rem;text-transform:uppercase;letter-spacing:.06em;margin-top:1px}
.rev-nav{display:flex;justify-content:flex-end;gap:10px;margin-top:14px}
@media(min-width:760px){.rev-nav{display:none}}
.rev-arrow{width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:var(--panel);color:var(--ink);font-size:1.3rem;line-height:1;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(18,18,18,.12);transition:transform .15s ease,box-shadow .15s ease}
.rev-arrow:hover{transform:translateY(-2px);box-shadow:0 6px 14px rgba(18,18,18,.18)}
.rev-cta{margin-top:22px;display:flex;flex-wrap:wrap;align-items:center;gap:14px;justify-content:space-between}
.rev-readmore{box-shadow:0 1px 2px rgba(18,18,18,.18),0 0 14px 2px rgba(255,205,17,.4)}
.rev-readmore:hover{box-shadow:0 8px 18px rgba(18,18,18,.24),0 0 20px 5px rgba(255,205,17,.55)}
@media(max-width:759px){.rev-cta{flex-direction:column;align-items:flex-start;gap:16px}.rev-cta .btn{width:100%;justify-content:center}}
.rating-badge{display:flex;align-items:center;gap:10px}
.rating-badge .n{font-family:"Big Shoulders Display";font-size:1.8rem;font-weight:800;line-height:1}
.rating-badge .stars-lg{font-size:1.8rem;line-height:1;color:var(--accent);letter-spacing:.04em}
.rating-badge .meta{font-size:.72rem;line-height:1.25;color:var(--ink-3)}

/* ---------------- areas ---------------- */
.areas-wrap{display:grid;gap:28px;grid-template-columns:1fr}
@media(min-width:860px){.areas-wrap{grid-template-columns:1.1fr 1fr}}
.area-list{display:flex;flex-wrap:wrap;gap:0;border-top:1px solid var(--line)}
.area-list a{flex:1 1 33%;min-width:150px;padding:13px 4px 13px 0;border-bottom:1px solid var(--line);font-weight:700;font-size:1rem;font-family:"Big Shoulders Display";text-transform:uppercase;display:flex;align-items:center;gap:8px}
.area-list a::before{content:"";width:6px;height:6px;background:var(--accent);flex:none}
.area-note{background:var(--panel);border:1px solid var(--line);padding:22px;display:flex;flex-direction:column;gap:10px}
.area-note h4{font-family:"Public Sans";text-transform:none;font-weight:700;font-size:1rem}
.area-note p{font-size:.9rem;color:var(--ink-2)}

/* ---------------- process ---------------- */
.process{display:grid;gap:0;grid-template-columns:1fr;border-top:1px solid var(--line);border-left:1px solid var(--line)}
@media(min-width:760px){.process{grid-template-columns:repeat(4,1fr)}}
.p-step{padding:22px 20px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;flex-direction:column;gap:8px;background:var(--panel)}
.p-step .num{font-family:"IBM Plex Mono";font-size:.72rem;color:var(--accent-ink);font-weight:700}
.p-step h4{font-family:"Public Sans";text-transform:none;font-weight:700;font-size:1.02rem}
.p-step p{font-size:.87rem;color:var(--ink-2)}

/* ---------------- faq ---------------- */
.faq{display:flex;flex-direction:column;border-top:1px solid var(--line)}
details{border-bottom:1px solid var(--line)}
details summary{padding:17px 4px;font-weight:700;font-size:1.02rem;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:14px;list-style:none;font-family:"Public Sans"}
details summary::-webkit-details-marker{display:none}
details summary::after{content:"+";font-family:"IBM Plex Mono";font-size:1.2rem;color:var(--accent-ink);flex:none;transition:transform .2s ease}
details[open] summary::after{content:"\2212"}
details p{padding:0 4px 18px;font-size:.93rem;color:var(--ink-2);max-width:66ch}

/* ---------------- final cta ---------------- */
.cta-band{position:relative;overflow:hidden;min-height:340px;display:flex;align-items:center}
.cta-band img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.cta-band::after{content:"";position:absolute;inset:0;background:linear-gradient(100deg,rgba(18,18,18,.92) 0%,rgba(46,36,3,.75) 55%,rgba(255,205,17,.3) 100%)}
@media(max-width:639px){.cta-band::after{background:linear-gradient(100deg,rgba(18,18,18,.94) 0%,rgba(30,24,2,.9) 55%,rgba(120,94,8,.6) 100%)}}
.cta-in{position:relative;z-index:2;padding:52px 20px;max-width:1180px;margin:0 auto;color:#F0F0F0;display:flex;flex-direction:column;gap:16px;max-width:520px}
.cta-in h2{color:#F8F8F8;font-size:clamp(2rem,5.6vw,2.9rem)}
.cta-in p{color:#C9C9C9;font-size:1rem;line-height:1.4}

/* ---------------- footer ---------------- */
/* ---------------- contact / estimate form ---------------- */
.contact{padding:56px 0;background:var(--panel);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.contact-wrap{max-width:1180px;margin:0 auto;padding:0 20px;display:grid;gap:0;grid-template-columns:1fr;border:1px solid var(--line)}
@media(min-width:860px){.contact-wrap{grid-template-columns:1fr 1.2fr;padding:0}}
.contact-map{position:relative;display:block;min-height:280px;background:#1A1A1A;overflow:hidden;cursor:pointer}
.contact-map svg{transition:transform .3s ease}
.contact-map:hover svg{transform:scale(1.03)}
.contact-map-badge{position:absolute;left:16px;bottom:16px;z-index:1;display:inline-flex;align-items:center;gap:6px;background:#1A1A1A;color:#F0F0F0;font-family:"IBM Plex Mono",monospace;font-size:.7rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:8px 14px;border-radius:999px;box-shadow:0 4px 12px rgba(18,18,18,.25);transition:background-color .15s ease}
.contact-map:hover .contact-map-badge{background:#FFCD11;color:#1A1A1A}
@media(min-width:860px){.contact-map{min-height:100%}}
.contact-map::before{content:"";position:absolute;inset:0;opacity:.08;background-image:
  repeating-linear-gradient(115deg,#D6D6D6 0 2px,transparent 2px 34px),
  repeating-linear-gradient(25deg,#D6D6D6 0 2px,transparent 2px 34px)}
.contact-map svg{position:absolute;inset:0;width:100%;height:100%}
.contact-form-side{padding:32px 22px}
@media(min-width:640px){.contact-form-side{padding:40px 36px}}
.contact-form-side .lbl{color:var(--accent-ink)}
.contact-form-side h2{margin-top:8px;font-size:clamp(1.9rem,4.6vw,2.5rem)}
.contact-form-side>p{margin-top:12px;color:var(--ink-2);font-size:.98rem;line-height:1.4;max-width:52ch}
.cform{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:26px}
.cfield-hp{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:639px){.cform{grid-template-columns:1fr}}
.cfield{display:flex;flex-direction:column;gap:4px;background:var(--line-2);border:1px solid var(--line);border-radius:8px;padding:12px 16px;transition:border-color .15s ease,box-shadow .15s ease}
.cfield:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px rgba(255,205,17,.14)}
.cfield-cap{font-family:"IBM Plex Mono";font-size:.66rem;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-3)}
.cfield input,.cfield select,.cfield textarea{border:0;background:transparent;font-family:"Public Sans";font-size:1rem;color:var(--ink);padding:0;outline:none;width:100%}
.cfield select{appearance:none;-webkit-appearance:none;background-image:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M5 8l5 5 5-5" fill="none" stroke="%23C9C9C9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>');background-repeat:no-repeat;background-position:right 2px center;background-size:16px;padding-right:20px}
.cfield textarea{resize:vertical;min-height:96px;font-family:inherit}
.cfield-full{grid-column:1/-1}
.cform-submit{grid-column:1/-1;width:100%;justify-content:center;padding:16px;font-size:.95rem;margin-top:4px}
.cform-note{grid-column:1/-1;font-size:.76rem;color:var(--ink-3);margin-top:-4px}
.cform-error{grid-column:1/-1;font-size:.85rem;font-weight:600;color:#FF6B57;margin-top:4px}
.cform-success{margin-top:26px;padding:26px 22px;background:var(--accent-tint);border:1px solid var(--line);border-radius:8px}
.cform-success h3{font-family:"Public Sans";text-transform:none;font-size:1.15rem;font-weight:700;color:var(--ink)}
.cform-success p{margin-top:8px;color:var(--ink-2);font-size:.94rem}

footer.site{position:relative;background:var(--dusk);color:var(--grit-2);padding:0 0 90px;border-top:3px solid var(--accent);overflow:hidden}
:root[data-theme="dark"] footer.site{background:var(--panel)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) footer.site{background:var(--panel)}}
footer.site::before{content:"";position:absolute;inset:0;opacity:.5;background-image:repeating-linear-gradient(115deg,rgba(240,240,240,.06) 0 1px,transparent 1px 30px);pointer-events:none}

.foot-top{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:22px;padding:40px 0 34px;border-bottom:1px solid rgba(240,240,240,.14)}
@media(min-width:760px){.foot-top{flex-direction:row;align-items:center;gap:36px}}
.foot-mark img{height:72px;width:auto;display:block}
@media(min-width:760px){.foot-mark img{height:92px}}
.foot-top-rule{display:none}
@media(min-width:760px){.foot-top-rule{display:block;align-self:stretch;width:1px;background:rgba(240,240,240,.18)}}
.foot-call{display:flex;flex-direction:column;gap:6px}
.foot-call .lbl{color:var(--accent)}
.foot-phone{font-family:"Big Shoulders Display";font-weight:800;font-size:clamp(1.9rem,5vw,2.7rem);letter-spacing:.01em;color:#F0F0F0;text-transform:uppercase;transition:color .15s ease}
.foot-phone:hover{color:var(--accent)}
.foot-call p{font-size:.9rem;color:var(--grit-2);max-width:44ch}

.foot-grid{position:relative;display:grid;gap:32px;grid-template-columns:1fr;padding:34px 0}
@media(min-width:560px){.foot-grid{grid-template-columns:1fr 1fr}}
