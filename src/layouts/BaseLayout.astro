.foot-col h5{display:flex;align-items:center;gap:9px;font-family:"IBM Plex Mono";font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--iron);font-weight:600;margin-bottom:14px}
.foot-col h5::before{content:"";width:8px;height:8px;border:1.5px solid var(--accent);flex:none}
.foot-col a,.foot-col p{display:block;font-size:.88rem;color:var(--grit-2);margin-bottom:8px}
.foot-col a:hover{color:#F0F0F0}
.foot-areas-list{display:flex;flex-wrap:wrap;gap:6px 0}
.foot-areas-list a{font-size:.84rem;margin-bottom:0;white-space:nowrap}
.foot-areas-list a:not(:last-child)::after{content:"\00b7";margin:0 7px;color:rgba(240,240,240,.3)}

.foot-bottom{position:relative;padding-top:22px;border-top:1px solid rgba(240,240,240,.14);display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:14px;font-size:.76rem;color:var(--ink-3)}
.foot-bottom-left{display:flex;flex-wrap:wrap;align-items:center;gap:12px}
.roc-badge{font-family:"IBM Plex Mono";font-size:.68rem;letter-spacing:.06em;color:var(--accent);border:1px solid rgba(255,205,17,.4);border-radius:999px;padding:4px 11px}
.foot-bottom-right{display:flex;align-items:center;gap:16px}
.foot-social{display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;border:1px solid rgba(240,240,240,.3);color:var(--grit-2);transition:color .15s ease,border-color .15s ease}
.foot-social:hover{color:var(--accent);border-color:var(--accent)}
.foot-social svg{width:15px;height:15px}

/* ---------------- sticky mobile bar ---------------- */
.mbar{position:fixed;left:0;right:0;bottom:0;z-index:50;display:grid;grid-template-columns:1fr 1fr 1fr;background:var(--dusk);border-top:1px solid rgba(214,214,214,.18);border-radius:14px 14px 0 0;overflow:hidden;box-shadow:0 -4px 16px rgba(18,18,18,.18)}
@media(min-width:900px){.mbar{display:none}}
.mbar a{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;padding:10px 4px;color:#F0F0F0;font-size:.68rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;border-right:1px solid rgba(214,214,214,.15)}
.mbar a:last-child{border-right:0}
.mbar a.hi{background:var(--accent);color:#1A1A1A}
.mbar svg{width:18px;height:18px}

/* ---------------- cookie consent ---------------- */
.cookie-banner{position:fixed;left:16px;bottom:16px;z-index:80;width:calc(100% - 32px);max-width:360px;background:var(--panel);color:var(--ink);border-radius:16px;padding:22px 22px 18px;box-shadow:0 14px 34px rgba(18,18,18,.28);border:1px solid var(--line)}
