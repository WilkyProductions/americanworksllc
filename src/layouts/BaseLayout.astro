---
export interface Props {
  title: string;
  description: string;
  path?: string;
  structuredData?: object | object[];
}
const { title, description, path = "/", structuredData } = Astro.props;
const structuredDataList = structuredData
  ? Array.isArray(structuredData) ? structuredData : [structuredData]
  : [];
const siteUrl = "https://americanworksllc.com";
const canonicalURL = new URL(path, siteUrl).toString();

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "American Works, LLC",
  "image": `${siteUrl}/video/hero-poster.jpg`,
  "telephone": "+16233431123",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Wittmann",
    "addressRegion": "AZ",
    "postalCode": "85361",
    "addressCountry": "US"
  },
  "areaServed": [
    "Wittmann, AZ", "Scottsdale, AZ", "Phoenix, AZ", "Surprise, AZ",
    "Peoria, AZ", "El Mirage, AZ", "Goodyear, AZ", "Buckeye, AZ",
    "New River, AZ", "Cave Creek, AZ", "Anthem, AZ", "Fountain Hills, AZ"
  ],
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
    "opens": "06:00",
    "closes": "19:00"
  },
  "url": siteUrl,
  "sameAs": ["https://www.facebook.com/TheAmericanWorks/"],
  "hasCredential": {
    "@type": "EducationalOccupationalCredential",
    "name": "Arizona ROC License",
    "credentialCategory": "ROC # 343361"
  }
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalURL}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="American Works, LLC">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:image" content="https://americanworksllc.com/video/hero-poster.jpg">
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
{structuredDataList.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@500;600&display=swap">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="apple-touch-icon" href="data:image/png;base64,">

<style is:global>
:root{
  --dusk:#121212;
  --caliche:#121212;
  --panel:#242424;
  --iron:#A3A3A3;
  --grit:#B0B0B0;
  --grit-2:#8A8A8A;
  --line:#3A3A3A;
  --line-2:#2E2E2E;
  --accent:#FFCD11;
  --accent-ink:#FFCD11;
  --accent-tint:#333333;
  --ink:#F0F0F0;
  --ink-2:#C9C9C9;
  --ink-3:#9A9A9A;
  --good:#8FB57B;
  --shadow:0 1px 0 rgba(0,0,0,.35);
}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation-duration:.001ms!important;transition-duration:.001ms!important}}
body{
  margin:0;background:var(--caliche);color:var(--ink);
  font-family:"Public Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  font-size:16.5px;line-height:1.55;-webkit-font-smoothing:antialiased;
  padding-bottom:64px; /* room for sticky bar */
}
h1,h2,h3,h4{font-family:"Big Shoulders Display",Impact,sans-serif;margin:0;line-height:.95;text-wrap:balance;text-transform:uppercase;letter-spacing:.005em}
p{margin:0}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer}
.mono{font-family:"IBM Plex Mono",ui-monospace,monospace}
.lbl{font-family:"IBM Plex Mono",monospace;font-size:.68rem;text-transform:uppercase;letter-spacing:.14em;color:var(--ink-3);font-weight:600}
img{max-width:100%;display:block}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px}
.skip-link{position:absolute;top:-80px;left:12px;z-index:100;background:#121212;color:#F0F0F0;padding:12px 20px;border-radius:6px;font-weight:700;font-size:.9rem;transition:top .15s ease}
.skip-link:focus{top:12px}
.stack{display:flex;flex-direction:column}
.tnum{font-variant-numeric:tabular-nums}

/* ---------------- announcement ---------------- */
/* ---------------- header ---------------- */
header.site{position:sticky;top:0;z-index:40;background:var(--panel);background:color-mix(in srgb,var(--panel) 68%,transparent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--line);box-shadow:var(--shadow)}
.nav{display:flex;align-items:center;gap:28px;padding:12px 20px;max-width:1180px;margin:0 auto}
.brand{display:flex;align-items:center;margin-right:auto}
.btn-quote{display:none;align-items:center;gap:6px;background:var(--accent);color:#1A1A1A;padding:10px 18px;font-weight:700;font-size:.82rem;letter-spacing:.05em;text-transform:uppercase;border-radius:6px;white-space:nowrap;transition:transform .15s ease,filter .15s ease;animation:quoteGlow 2.6s ease-in-out infinite}
.btn-quote:hover{transform:translateY(-2px);filter:brightness(1.08)}
@media(min-width:900px){.btn-quote{display:inline-flex}}
@keyframes quoteGlow{
  0%,100%{box-shadow:0 0 0 1px rgba(255,205,17,.55),0 0 14px 2px rgba(255,205,17,.35)}
  50%{box-shadow:0 0 0 1px rgba(255,205,17,.75),0 0 26px 8px rgba(255,205,17,.55)}
}
.brand img{height:30px;width:auto;display:block;flex-shrink:0}
@media(min-width:640px){.brand img{height:34px}}
@media(min-width:900px){.brand img{height:51px}}
.nav-actions{display:flex;align-items:center;gap:10px}
@media(max-width:899px){
  .nav{display:grid;grid-template-columns:44px 1fr 44px;align-items:center;column-gap:8px}
  .brand{grid-column:2;justify-self:center}
  .nav-actions{grid-column:3;justify-self:end}
}
.navlinks{display:none;gap:26px;font-size:.86rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.nav-dropdown{position:relative}
.nav-dropdown>a{display:inline-flex;align-items:center;gap:6px}
.nav-caret{width:10px;height:7px;transition:transform .15s ease}
.nav-dropdown:hover .nav-caret,.nav-dropdown:focus-within .nav-caret{transform:rotate(180deg)}
.nav-dropdown-menu{position:absolute;top:100%;left:50%;transform:translate(-50%,-6px);margin-top:16px;min-width:230px;background:var(--panel);border:1px solid var(--line);border-radius:8px;box-shadow:0 14px 32px rgba(18,18,18,.18);padding:8px;opacity:0;visibility:hidden;transition:opacity .15s ease,transform .15s ease,visibility .15s}
.nav-dropdown:hover .nav-dropdown-menu,.nav-dropdown:focus-within .nav-dropdown-menu{opacity:1;visibility:visible;transform:translate(-50%,0)}
.nav-dropdown-menu a{display:block;padding:10px 12px;border-radius:6px;font-size:.86rem;font-weight:600;letter-spacing:normal;text-transform:none;color:var(--ink)}
.nav-dropdown-menu a:hover{background:var(--line-2);color:var(--accent-ink)}
@media(min-width:900px){.navlinks{display:flex}}
.burger{display:flex;flex-direction:column;justify-content:center;gap:4px;background:none;border:0;padding:6px;width:32px;height:32px}
.burger span{width:20px;height:2px;background:var(--ink);transition:transform .25s ease,opacity .2s ease}
.burger.open span:nth-child(1){transform:translateY(6px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
@media(min-width:900px){.burger{display:none}}
.mobile-menu{display:none}
@media(max-width:899px){
  .mobile-menu{display:flex;flex-direction:column;max-height:0;overflow:hidden;transition:max-height .32s ease;max-width:1180px;margin:0 auto;padding:0 20px}
  .mobile-menu.open{max-height:360px}
  .mobile-menu a{padding:15px 4px;border-bottom:1px solid var(--line);font-family:"Big Shoulders Display";font-weight:700;font-size:1.08rem;letter-spacing:.05em;text-transform:uppercase;color:var(--ink)}
  .mobile-menu a:last-child{border-bottom:0}
  .mobile-menu .btn-quote{display:inline-flex;align-self:center;padding:10px 18px;border-bottom:0;margin:14px 0 18px;animation:none;color:#1A1A1A;box-shadow:0 0 0 1px rgba(255,205,17,.6),0 0 16px 3px rgba(255,205,17,.4)}
}

/* ---------------- hero ---------------- */
.hero{position:relative;margin-top:-64px;min-height:calc(min(88vh,720px) + 64px);display:flex;align-items:flex-end;overflow:hidden}
@media(min-width:900px){.hero{margin-top:-76px;min-height:calc(min(88vh,720px) + 76px)}}
@media(max-width:899px){.hero{min-height:calc(72vh + 64px);min-height:calc(72svh + 64px)}}
.hero video,.hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 62%}
.video-toggle{position:absolute;z-index:3;bottom:16px;right:16px;width:40px;height:40px;border-radius:50%;background:rgba(18,18,18,.55);color:#F0F0F0;border:1px solid rgba(240,240,240,.4);display:flex;align-items:center;justify-content:center;backdrop-filter:blur(6px);transition:background-color .15s ease,transform .15s ease}
.video-toggle:hover{background:rgba(18,18,18,.8);transform:translateY(-2px)}
.video-toggle svg{width:18px;height:18px}
.hero::after{content:"";position:absolute;inset:0;background:
    linear-gradient(0deg,rgba(18,18,18,.88) 0%,rgba(18,18,18,.5) 21%,rgba(18,18,18,.12) 36%,rgba(18,18,18,0) 50%),
    linear-gradient(0deg,rgba(140,108,9,.95) 0%,rgba(255,205,17,.55) 14%,rgba(255,205,17,.18) 26%,rgba(255,205,17,0) 39%)}
.hero-in{position:relative;z-index:2;width:100%;max-width:1180px;margin:0 auto;padding:0 20px 40px;color:#F0F0F0;display:flex;flex-direction:column;gap:18px;text-shadow:0 1px 2px rgba(0,0,0,.55),0 0 10px rgba(0,0,0,.4)}
.hero-in .btn-primary{text-shadow:none}
.hero h1{font-size:clamp(2.6rem,8.4vw,4.6rem);font-weight:800;color:#F8F8F8}
@media(max-width:899px){.hero h1{line-height:.88}}
.hero .rule{width:64px;height:3px;background:var(--accent)}
.hero-sub{font-size:1.02rem;line-height:1.4;max-width:52ch;color:#D6D6D6}
.hero-cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:6px}
@media(max-width:520px){.hero-cta{flex-wrap:nowrap;gap:8px}.hero-cta .btn{flex:1;padding:12px 10px;font-size:.76rem;gap:5px;white-space:nowrap}}
.btn{padding:14px 22px;font-weight:700;font-size:.9rem;letter-spacing:.04em;text-transform:uppercase;display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1.5px solid transparent;border-radius:6px;box-shadow:0 1px 2px rgba(18,18,18,.18);transition:transform .15s ease,box-shadow .15s ease,filter .15s ease,background-color .15s ease}
.btn:hover{transform:translateY(-2px);box-shadow:0 8px 18px rgba(18,18,18,.24)}
.btn:active{transform:translateY(0);box-shadow:0 1px 2px rgba(18,18,18,.18)}
.btn-primary{background:var(--accent);color:#1A1A1A}
.btn-primary:hover{filter:brightness(1.08)}
.btn-ghost{background:transparent;color:#F0F0F0;border-color:rgba(240,240,240,.55)}
.btn-ghost:hover{background:rgba(240,240,240,.1);border-color:rgba(240,240,240,.8)}
.trustrow{display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:14px;padding-top:14px;border-top:1px solid rgba(240,240,240,.22)}
@media(max-width:899px){
  .trustrow{display:grid;grid-template-columns:1fr 1fr;gap:8px;border-top:0;padding-top:0}
  .trustrow span{background:#121212;border:1px solid rgba(240,240,240,.3);border-radius:999px;padding:8px 10px;font-size:.68rem;line-height:1.35;justify-content:center;text-align:center}
  .trustrow .dot{display:none}
}
.trustrow span{font-size:.78rem;color:#C9C9C9;display:flex;align-items:center;gap:7px;font-weight:600;letter-spacing:.02em}
@media(min-width:900px){.pill-break{display:none}}
.trustrow .dot{width:5px;height:5px;background:var(--accent);border-radius:50%;flex:none}

/* ---------------- answer block ---------------- */
.answer{position:relative;background:var(--dusk);overflow:hidden}
.answer::before,.answer::after{content:"";position:absolute;left:0;right:0;height:2px;background:linear-gradient(90deg,rgba(255,205,17,0) 0%,rgba(255,205,17,.9) 50%,rgba(255,205,17,0) 100%)}
.answer::before{top:0}
.answer::after{bottom:0}
.answer-in{position:relative;z-index:1;max-width:1180px;margin:0 auto;padding:28px 20px;display:grid;gap:16px;grid-template-columns:1fr}
@media(min-width:760px){.answer-in{padding:34px 20px}}
.answer p{font-size:.93rem;line-height:1.4;color:#C9C9C9;max-width:none}
.answer p strong{color:#FFCD11;font-weight:700}

/* ---------------- scroll reveal: skid steer clears the ground ---------------- */
.reveal-wrap{position:relative;height:250vh}
@media(prefers-reduced-motion:reduce){.reveal-wrap{height:auto}}
.reveal-stage{position:sticky;top:64px;height:94vh;min-height:520px;max-height:900px;overflow:hidden;display:flex;align-items:center}
@media(max-width:899px){.reveal-stage{height:88svh;top:calc(32px + 6svh)}}
@media(prefers-reduced-motion:reduce){.reveal-stage{position:relative;height:auto;min-height:0;max-height:none;padding:64px 0}}
.reveal-ground{position:absolute;inset:0;background-size:cover;background-position:center 38%}
.reveal-ground::before{content:"";position:absolute;inset:0;background:linear-gradient(100deg,rgba(18,18,18,.6) 0%,rgba(18,18,18,.38) 50%,rgba(18,18,18,.6) 100%)}
.reveal-prompt{position:absolute;inset:0;z-index:1;display:flex;align-items:flex-start;justify-content:center;text-align:center;padding:28px 24px 0;pointer-events:none;opacity:calc(1 - var(--progress,1));transition:opacity .15s linear}
@media(prefers-reduced-motion:reduce){.reveal-prompt{display:none}}
.reveal-prompt span{font-family:"Big Shoulders Display";font-weight:800;font-size:clamp(1.5rem,4.8vw,2.5rem);letter-spacing:.06em;color:#FAFAFA;animation:promptPulse 2s ease-in-out infinite}
@keyframes promptPulse{
  0%,100%{text-shadow:0 0 8px rgba(255,205,17,.9),0 0 22px rgba(255,205,17,.6),0 0 42px rgba(255,205,17,.35)}
  50%{text-shadow:0 0 12px rgba(255,205,17,1),0 0 32px rgba(255,205,17,.8),0 0 60px rgba(255,205,17,.55)}
}
.reveal-revealed{position:absolute;inset:0;z-index:2;clip-path:inset(0 0 0 calc((1 - var(--progress,1)) * 100%));will-change:clip-path}
@media(prefers-reduced-motion:reduce){.reveal-revealed{clip-path:none}}
.reveal-photo{position:absolute;inset:0;background-size:cover;background-position:center 40%}
.reveal-scrim{position:absolute;inset:0;background:linear-gradient(100deg,rgba(18,18,18,.82) 0%,rgba(18,18,18,.6) 40%,rgba(18,18,18,.42) 100%)}
.reveal-copy{position:relative;z-index:3;max-width:1180px;margin:0 auto;padding:0 20px;width:100%}
.reveal-copy h2{color:#F8F8F8;font-size:clamp(1.9rem,5.2vw,3.1rem);max-width:14ch}
.reveal-copy p{margin-top:14px;color:#D6D6D6;font-size:1.04rem;line-height:1.4;max-width:46ch}
.reveal-machine{position:absolute;bottom:6%;width:360px;height:auto;z-index:4;pointer-events:none;filter:drop-shadow(0 8px 10px rgba(18,18,18,.35));
  left:calc((1 - var(--progress,1)) * 100% - 40px);will-change:left}
@media(prefers-reduced-motion:reduce){.reveal-machine{display:none}}
@media(min-width:640px){.reveal-machine{width:440px}}

/* ---------------- section shell ---------------- */
section.block{padding:56px 0}
.block-hd{display:flex;flex-direction:column;gap:10px;margin-bottom:30px;max-width:640px}
.block-hd h2{font-size:clamp(1.9rem,5vw,2.6rem)}
.block-hd p{color:var(--ink-2);font-size:1rem}
.stake{display:inline-flex;align-items:center;gap:8px}
.stake::before{content:"";width:14px;height:14px;border:2px solid var(--accent);flex:none}

/* ---------------- services ---------------- */
.svc-grid{display:grid;gap:2px;background:var(--line);border:1px solid var(--line);grid-template-columns:1fr 1fr}
@media(min-width:980px){.svc-grid{grid-template-columns:repeat(3,1fr)}}
.svc-card{background:var(--panel);display:flex;flex-direction:column}
.svc-card .ph{overflow:hidden;position:relative;aspect-ratio:4/3;display:block;width:100%;border:0;padding:0;background:none;cursor:pointer}
.svc-card .ph img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}
.svc-card:hover .ph img{transform:scale(1.045)}
.svc-card .bd{padding:18px 18px 22px;display:flex;flex-direction:column;gap:8px;flex:1}
.svc-card h3{font-size:1.32rem;font-weight:700}
.svc-card h3 a:hover{text-decoration:underline;text-underline-offset:3px}
.svc-card p{font-size:.9rem;line-height:1.35;color:var(--ink-2);flex:1}
.svc-card.stub .ph{cursor:default;background:repeating-linear-gradient(135deg,var(--line-2),var(--line-2) 8px,var(--panel) 8px,var(--panel) 16px);display:flex;align-items:center;justify-content:center}
.svc-card.stub .ph span{font-family:"IBM Plex Mono";font-size:.66rem;letter-spacing:.1em;color:var(--ink-3);text-transform:uppercase;background:var(--panel);padding:5px 9px;border:1px solid var(--line)}

/* ---------------- proof ---------------- */
/* base / tablet-gap (760-859px) fallback layout: narrow photo column + panel */
.proof-wrap{display:grid;gap:0;grid-template-columns:104px 1fr;border:1px solid var(--line)}
@media(min-width:480px){.proof-wrap{grid-template-columns:150px 1fr}}
@media(min-width:640px){.proof-wrap{grid-template-columns:230px 1fr}}
.proof-img{overflow:hidden;height:100%}
.proof-img img{width:100%;height:100%;object-fit:cover}
.proof-list{padding:26px 22px;display:flex;flex-direction:column;gap:22px;background:var(--panel)}
.proof-item{display:flex;gap:14px}
.proof-item .mk{font-family:"Big Shoulders Display";font-weight:800;font-size:1.5rem;color:var(--accent-ink);flex:none;width:34px}
.proof-item h4{font-family:"Public Sans";text-transform:none;font-size:1.02rem;font-weight:700;color:var(--ink)}
.proof-item p{font-size:.9rem;color:var(--ink-2);margin-top:3px}

/* eyebrow + title always sit on top of the background image, not above it */
.proof-section{position:relative;overflow:hidden}
.proof-section .block-hd{position:relative;z-index:1}
.proof-section .block-hd .lbl{color:#FFCD11}
.proof-section .block-hd h2{color:#F8F8F8}

/* mobile ≤759px: full-bleed photo background behind the whole section */
@media(max-width:759px){
  .proof-wrap{position:static;display:block;border:0}
  .proof-img{position:absolute;top:51px;right:0;bottom:51px;left:0;height:auto;z-index:0}
  .proof-img::after{content:"";position:absolute;inset:0;background:rgba(18,18,18,.74)}
  .proof-list{position:relative;z-index:1;background:transparent;padding:32px 22px}
  .proof-item .mk{color:var(--accent)}
  .proof-item h4{color:#F8F8F8}
  .proof-item p{color:#D6D6D6}
}

/* desktop ≥860px: image stretches edge-to-edge like the hero, content stays readable-width */
@media(min-width:860px){
  .proof-section.wrap{max-width:none}
  .proof-section .block-hd{max-width:1180px;margin-left:auto;margin-right:auto;padding-left:20px;padding-right:20px}
  .proof-wrap{position:static;display:block;border:0;min-height:480px}
  .proof-img{position:absolute;inset:0;height:100%}
  .proof-img::after{content:"";position:absolute;inset:0;background:rgba(18,18,18,.82)}
  .proof-list{position:relative;z-index:1;background:transparent;display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:1180px;margin:0 auto;padding:56px 20px;height:100%;align-content:center}
  .proof-item{background:var(--accent);border-radius:8px;padding:28px 26px}
  .proof-item:nth-child(3){grid-column:1/-1;max-width:540px;width:100%;margin:0 auto}
  .proof-item .mk{background:#121212;color:#FFFFFF;width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.05rem}
  .proof-item h4{color:#1A1A1A}
  .proof-item p{color:#1A1A1A}
}

/* ---------------- before/after placeholder ---------------- */
.ba-shell{border:1px dashed var(--grit-2);background:var(--line-2);padding:36px 24px;display:flex;flex-direction:column;align-items:flex-start;gap:12px}
.ba-shell .icon{width:38px;height:38px;border:2px solid var(--ink-3);display:flex;align-items:center;justify-content:center;font-family:"IBM Plex Mono";font-size:.7rem;color:var(--ink-3)}
.ba-shell h4{font-family:"Public Sans";text-transform:none;font-weight:700;font-size:1.05rem;color:var(--ink)}
.ba-shell p{font-size:.9rem;color:var(--ink-2);max-width:56ch}

/* ---------------- reviews ---------------- */
.rev-strip{position:relative;display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:4px 4px 4px 4px}
.rev-strip::-webkit-scrollbar{display:none}
@media(max-width:759px){.rev-strip.peek-hint{animation:revPeekHint 1.4s ease .15s 1 both}}
@keyframes revPeekHint{
  0%{transform:translateX(0)}
  28%{transform:translateX(-24px)}
  52%{transform:translateX(-4px)}
  74%{transform:translateX(-15px)}
  100%{transform:translateX(0)}
}
@media(min-width:760px){.rev-strip{display:grid;gap:1px;background:var(--line);border:1px solid var(--line);grid-template-columns:repeat(3,1fr);overflow-x:visible;scroll-snap-type:none;padding:0}}
.rev-card{scroll-snap-align:start;flex:0 0 calc(100% - 60px);background:var(--panel);padding:28px 24px;display:flex;flex-direction:column;gap:15px;border:1px solid var(--line);border-radius:8px}
@media(min-width:760px){.rev-card{flex:none;border:0;border-radius:0;padding:22px 20px;gap:12px}}
